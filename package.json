{
  "name": "fiu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && vercel link --yes && vercel env pull --yes && npm run typegen",
    "predev": "npm run typegen",
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev",
    "prebuild": "npm run typegen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typegen": "sanity schema extract --enforce-required-fields --force --path=sanity/extract.json && sanity typegen generate",
    "pretypecheck": "npm run typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "email:dev": "email dev --dir emails",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "sync:dev": "tsx --env-file=.env.local scripts/sync-dev.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sanity/client": "^8.11.0",
    "@sanity/document-internationalization": "^6.2.45",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/vision": "^6.20.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.35.0",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "^6.11.6",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.11.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{css,json,md,yml}": "prettier --write"
  },
  "overrides": {
    "@react-email/render": "2.2.0"
  }
}
