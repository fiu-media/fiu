{
  "name": "fiu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && vercel link --yes --scope fiu-media --project fiu && vercel env pull --yes && npm run typegen",
    "predev": "npm run typegen",
    "dev": "NODE_OPTIONS=--no-experimental-webstorage next dev",
    "prebuild": "npm run typegen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typegen": "sanity schema extract --enforce-required-fields --force --path=sanity/extract.json && sanity typegen generate",
    "pretypecheck": "npm run typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:serve": "tsx e2e/fixtures/seed.ts && npm run build && npm run start",
    "email:dev": "email dev --dir emails",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "sync:dev": "tsx --env-file=.env.local scripts/sync-dev.ts",
    "check:email-eai": "tsx --env-file=.env.local scripts/check-resend-eai.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@conform-to/react": "^1.21.3",
    "@conform-to/zod": "^1.21.3",
    "@opentelemetry/api": "^1.10.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sanity/client": "^8.11.0",
    "@sanity/document-internationalization": "^6.2.46",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/vision": "^6.22.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vimeo/player": "^2.30.4",
    "botid": "^1.5.12",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-react": "^8.6.0",
    "intl-messageformat": "^12.1.4",
    "leva": "^0.10.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.8",
    "resend": "^6.37.0",
    "sanity": "^6.22.0",
    "simple-icons": "^16.36.0",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "^6.11.6",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "groq-js": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{css,json,md,yml}": "prettier --write"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
