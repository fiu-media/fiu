# Validated in env.ts. Required: the two NEXT_PUBLIC_SANITY_* values. Required in production
# (VERCEL_ENV=production): SANITY_API_WRITE_TOKEN, RESEND_API_KEY, RESEND_EMAIL_DOMAIN, AUTH_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. Everything else is optional.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Viewer token: server-side live content + draft mode
SANITY_API_READ_TOKEN=
# Required in production. Editor token: seed script and form submissions (quote requests, contact messages). Server-only.
SANITY_API_WRITE_TOKEN=

# Resend (both required in production): confirmation + notification emails for quote requests and contact messages.
# The domain must be verified in Resend; mail is sent from hello@ that domain (an internationalised domain is sent as
# punycode, so mail.fiú.ie and mail.xn--fi-ska.ie are the same). Use a subdomain (mail.fiú.ie), not the root, to keep
# transactional mail's reputation apart from everything else; the DMARC record on the root domain covers it.
# Recipients are the Contact email and Quote request recipient in Site settings (Studio).
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Optional. The Resend segment ("General") that contact-form submitters are added to, as unsubscribed contacts.
# Without it they're added to no segment. Contacts also need a custom `phone` property in Resend (Audience > Properties).
RESEND_SEGMENT_ID=
# Optional. Public origin, used for the logo and links in notification emails
NEXT_PUBLIC_SITE_URL=

# Studio only (hosted at fiu.sanity.studio, built by `sanity deploy`). Optional locally: the NEXT_PUBLIC_ values above are the fallback.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
# Optional. The site Presentation previews; set to http://localhost:3000 to preview a local server from `sanity dev`.
# SANITY_STUDIO_PREVIEW_ORIGIN=

# Staff sign-in (the pre-launch gate and /dev). Google OAuth client of type Internal on our Workspace, with the redirect URI
# <site>/api/auth/callback/google (https://xn--fi-ska.ie/... in production, http://localhost:3000/... locally).
# All three are required in production; AUTH_SECRET is at least 32 random characters (`openssl rand -base64 32`).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Only Google accounts in this Workspace domain can sign in (default xn--fi-ska.ie, the same as fiú.ie).
AUTH_ALLOWED_DOMAIN=
# Optional. "on" or "off" forces the gate on or off. Unset, it is on in production only (previews and local dev are open).
SITE_GATE=
