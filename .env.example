# Validated in env.ts. Required: the two NEXT_PUBLIC_SANITY_* values. Required in production
# (VERCEL_ENV=production): SANITY_API_WRITE_TOKEN and RESEND_API_KEY. Everything else is optional.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional. Viewer token: server-side live content + draft mode
SANITY_API_READ_TOKEN=
# Required in production. Editor token: seed script and form submissions (quote requests, contact messages). Server-only.
SANITY_API_WRITE_TOKEN=

# Resend (key required in production): confirmation + notification emails for quote requests and contact messages
RESEND_API_KEY=
# Optional. Verified Resend sending address, e.g. "Fiú Media <hello@your-domain.ie>". Falls back to Resend's sandbox sender.
EMAIL_FROM=
# Optional. Fallback recipient when Site settings has no quote/contact email
QUOTE_TO_EMAIL=
# Optional. Public origin, used for the Studio deep link in notification emails
NEXT_PUBLIC_SITE_URL=
