NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: server-side live content + draft mode
SANITY_API_READ_TOKEN=
# Editor token: seed script and form submissions (quote requests, contact messages). Server-only.
SANITY_API_WRITE_TOKEN=

# Resend: confirmation + notification emails for quote requests and contact messages
RESEND_API_KEY=
# Verified Resend sending address, e.g. "Fiú Media <hello@your-domain.ie>". Falls back to Resend's sandbox sender.
EMAIL_FROM=
# Fallback recipient when Site settings has no quote/contact email
QUOTE_TO_EMAIL=
# Public origin, used for the Studio deep link in notification emails
NEXT_PUBLIC_SITE_URL=
